# Copy this file to .env.local and paste your real values there.
# Never commit .env.local and never put a key or password in code,
# in chat, or in Linear. See docs/DEPLOY.md for the click-by-click guide.
#
# Meta Model API key. Without it, the app still works in MOCK mode
# (fake tasks, and voice input is unavailable locally).
MODEL_API_KEY=
#
# Secret used to sign sign-in cookies (SEC1). Sign-ins are signed cookies,
# not a server list, so they survive a server restart for 12 hours.
# Put a long random value here (for example 32+ random characters from a
# password manager). Never share it. If it is empty, the app uses a clearly
# marked development fallback so local testing still works — always set a
# real value online (Vercel env settings).
SESSION_SECRET=
#
# Demo safety (SEC1). DEMO_MODE=true turns this copy into a public demo
# sandbox: demo accounts + password are shown on /login, a fresh hotel
# loads demo data automatically, and guest room links work without the
# QR token. Leave empty/false for a real hotel.
DEMO_MODE=
#
# ALLOW_DEMO_RESET=true shows the Owner "Reset demo data" button and lets
# it run. Default (empty/false) = reset is hidden and refused by the server.
# FILE MODE ONLY (.data on one computer). When DATABASE_URL is set this
# value is ignored, so the shared online database can never be wiped by it.
ALLOW_DEMO_RESET=
#
# ALLOW_DB_RESET=true is the ONLY way to open Reset demo data while
# DATABASE_URL is set. Never set it online (Vercel) — the Mac and the
# online app share the same database. Local database testing only.
ALLOW_DB_RESET=
#
# APP_URL: the public online address of this app, e.g.
# https://hotelapp-liveops-xxxx.vercel.app (no path at the end). QR codes
# and printed login cards use it, so they never point at localhost or a
# preview address. Set it in Vercel after the first deploy (then redeploy).
# Leave empty for plain local dev.
APP_URL=
#
# CRON_SECRET: protects the daily /api/cron/daily job on Vercel (retention
# cleanup + check-out cleaning backstop). Make it like SESSION_SECRET:
# a long random value from a password manager. Vercel sends it by itself.
CRON_SECRET=
#
# RESTORE_SECRET: the secret code for the hidden page /admin/restore,
# which deletes ALL hotel data and loads a fresh demo hotel. Checked only
# on the server (5 tries per 10 minutes); a normal sign-in — even Owner —
# is NOT enough without it, because the demo owner password is public.
# Make it long and random like SESSION_SECRET, keep it in your password
# manager, and never share it. Empty = the restore page cannot run.
RESTORE_SECRET=
#
# Daily cap on real AI calls (SEC1). When reached, the app switches to
# clearly marked MOCK answers and logs one line. Default 500.
AI_DAILY_LIMIT=500
#
# Supabase Postgres connection string. Needed from M2 (ANT-18).
# Use the "Transaction pooler" URI (port 6543) from Supabase:
# Connect -> Transaction pooler. Leave empty for local dev: the app then
# uses the local .data files exactly as before. Only paste the real string
# into .env.local on your own Mac (to test the database) and into Vercel
# env settings. Server only, never NEXT_PUBLIC_.
DATABASE_URL=
#
# Photo storage (Supabase Storage, private bucket), from M2. Guests and
# the public can never open the bucket directly; the app serves photos
# through its sign-in-checked route. Server only: never rename these to
# NEXT_PUBLIC_... and never send them to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTOS_BUCKET=task-photos
